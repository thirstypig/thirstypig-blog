---
// Consent-gated AdSense unit. Renders nothing unless BOTH the publisher ID
// (PUBLIC_ADSENSE_PUB_ID) and a slot ID (passed in) are configured — so no
// broken <ins> ships before the ad units exist in the AdSense dashboard.
// The push() call is type="text/plain" data-category="marketing": vanilla-cookieconsent
// flips it to executable only after marketing consent, matching the gated loader
// in BaseLayout. Reserves min-height to limit cumulative layout shift.
interface Props {
	slotId: string | undefined;
}
const { slotId } = Astro.props;
const adClient = import.meta.env.PUBLIC_ADSENSE_PUB_ID;
const enabled = Boolean(adClient && slotId);
---

{enabled && (
	<aside class="ad-slot" aria-label="Advertisement">
		<span class="ad-label">Advertisement</span>
		<ins
			class="adsbygoogle"
			style="display:block"
			data-ad-client={adClient}
			data-ad-slot={slotId}
			data-ad-format="auto"
			data-full-width-responsive="true"
		></ins>
		<script type="text/plain" data-category="marketing" is:inline>
			(adsbygoogle = window.adsbygoogle || []).push({});
		</script>
	</aside>
)}

<style>
	.ad-slot {
		display: block;
		margin: 2rem auto;
		text-align: center;
		min-height: 280px;
	}
	.ad-label {
		display: block;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-stone, #78716c);
		margin-bottom: 0.25rem;
	}
</style>
