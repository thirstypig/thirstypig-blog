---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import 'vanilla-cookieconsent/dist/cookieconsent.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: Date;
	categories?: string[];
	location?: string;
	address?: string;
	coordinates?: { lat: number; lng: number };
	city?: string;
	region?: string;
}

const props = Astro.props;

// Validate env var formats before interpolating into set:html — prevents a
// misconfigured secret from producing broken HTML on every page.
const rawGa4 = import.meta.env.PUBLIC_GA4_ID;
const rawAdsense = import.meta.env.PUBLIC_ADSENSE_PUB_ID;
const ga4Id = /^G-[A-Z0-9]+$/.test(rawGa4 ?? '') ? rawGa4 : null;
const adsenseId = /^ca-pub-\d+$/.test(rawAdsense ?? '') ? rawAdsense : null;

// Consent-gated tracker tags. Emitted as type="text/plain" so the browser
// treats them as inert data and never executes them on load. vanilla-cookieconsent
// flips the type to an executable script only when the matching consent category
// is accepted (analytics → GA4, marketing → AdSense). This is the structural
// guarantee that nothing fires before opt-in — there is no public-site CSP backstop.
const trackerTags = [
	ga4Id &&
		`<script type="text/plain" data-category="analytics" src="https://www.googletagmanager.com/gtag/js?id=${ga4Id}"></script>` +
		`<script type="text/plain" data-category="analytics">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');</script>`,
	adsenseId &&
		`<script type="text/plain" data-category="marketing" async crossorigin="anonymous" src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}"></script>`,
].filter(Boolean).join('\n');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="The Thirsty Pig" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<!-- Fonts are self-hosted via @fontsource (loaded in global.css) -->
		<SEO {...props} />
		<!-- Inline theme init to prevent FOUC -->
		<script is:inline>
			(function() {
				const saved = localStorage.getItem('theme');
				const prefer = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.setAttribute('data-theme', saved || prefer);
			})();
		</script>
		<!-- CookieConsent banner: bundled from npm (self-hosted). Loads first, then manages the gated tags below. -->
		<script>
			import * as CookieConsent from 'vanilla-cookieconsent';
			CookieConsent.run({
				categories: {
					necessary: { enabled: true, readOnly: true },
					analytics: { enabled: false },
					marketing: { enabled: false },
				},
				language: {
					default: 'en',
					translations: {
						en: {
							consentModal: {
								title: 'We respect your privacy',
								description:
									"Thirstypig uses analytics and ads to improve your experience. You control what's allowed.",
								acceptAllBtn: 'Accept all',
								acceptNecessaryBtn: 'Reject non-essential',
								showPreferencesBtn: 'Manage preferences',
							},
							preferencesModal: {
								title: 'Manage your privacy preferences',
								acceptAllBtn: 'Accept all',
								acceptNecessaryBtn: 'Reject non-essential',
								savePreferencesBtn: 'Save my choices',
								sections: [
									{
										title: 'Strictly Necessary',
										description: 'Essential for the site to work.',
										linkedCategory: 'necessary',
									},
									{
										title: 'Analytics',
										description: 'Google Analytics 4 — understand how you use thirstypig.',
										linkedCategory: 'analytics',
									},
									{
										title: 'Marketing',
										description: 'Google AdSense — helps fund the blog.',
										linkedCategory: 'marketing',
									},
								],
							},
						},
					},
				},
			});
		</script>
		<!-- Consent-gated analytics/advertising tags (inert type="text/plain" until opt-in) -->
		<Fragment set:html={trackerTags} />
	</head>
	<body class="min-h-screen flex flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-amber focus:text-cream focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:no-underline"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" tabindex="-1" class="flex-1">
			<slot />
		</main>
		<Footer />
		<script>
			import { inject } from '@vercel/analytics';
			inject();
		</script>
	</body>
</html>
