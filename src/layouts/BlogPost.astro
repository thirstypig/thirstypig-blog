---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { slugify } from '../utils';
import FormattedDate from '../components/FormattedDate.astro';
import LocationCard from '../components/LocationCard.astro';
import VenueTags from '../components/VenueTags.astro';
import AdSlot from '../components/AdSlot.astro';
import AdInArticle from '../components/AdInArticle.astro';
import { getImageInfo } from '../utils/image-dimensions.mjs';

type Props = CollectionEntry<'posts'>['data'];

const {
	title,
	description,
	pubDate,
	heroImage,
	images = [],
	categories = [],
	tags = [],
	author,
	source,
	originalUrl,
	location,
	city,
	region,
	address,
	coordinates,
	placeId,
} = Astro.props;

const heroInfo = heroImage ? await getImageInfo(heroImage) : null;

// Extra images (same full-size treatment as hero, rendered after the in-article ad)
const galleryImages = [...new Set(images)].filter(img => img !== heroImage);
const galleryInfos = await Promise.all(galleryImages.map(img => getImageInfo(img)));

const adSlotTop = import.meta.env.PUBLIC_ADSENSE_SLOT_TOP;
const adSlotBottom = import.meta.env.PUBLIC_ADSENSE_SLOT_BOTTOM;
const adSlotInArticle = import.meta.env.PUBLIC_ADSENSE_SLOT_INARTICLE;
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	type="article"
	publishDate={pubDate}
	categories={categories}
	location={location}
	address={address}
	coordinates={coordinates}
	city={city}
	region={region}
	heroPreloadHref={heroInfo?.webp}
>
	<article class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
		<!-- Header -->
		<header class="mb-6">
			{categories.length > 0 && (
				<div class="flex flex-wrap gap-2 mb-4">
					{categories.map(cat => (
						<a
							href={`/categories/${slugify(cat)}/`}
							class="text-xs font-medium text-amber bg-amber/10 px-2.5 py-1 rounded-full hover:bg-amber/20 transition-colors no-underline"
						>
							{cat}
						</a>
					))}
				</div>
			)}
			<h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-ink leading-tight mb-4">
				{title}
			</h1>
			<div class="flex items-center gap-3 text-sm text-stone">
				<span>By {author || 'The Thirsty Pig'}</span>
				<span class="text-cream-dark">&bull;</span>
				<FormattedDate date={pubDate} />
			</div>
		</header>

		<!-- Location Card -->
		<LocationCard
			location={location}
			city={city}
			region={region}
			address={address}
			coordinates={coordinates}
		/>

		<!-- Venue chips (renders only when placeId has chip data published) -->
		<VenueTags placeId={placeId} />

		<!-- Ad: top of article -->
		<AdSlot slotId={adSlotTop} />

		<!-- 2. Caption / post body -->
		<div class="prose max-w-none">
			<slot />
		</div>

		<!-- 3. Hero image -->
		{heroImage && heroInfo && (
			<div class="post-image-wrap mt-6 -mx-4 sm:mx-0">
				<picture>
					{heroInfo.webp && <source type="image/webp" srcset={heroInfo.webp} />}
					<img
						src={heroImage}
						alt={title}
						width={heroInfo.width}
						height={heroInfo.height}
						class="post-image w-full rounded-none sm:rounded-xl shadow-lg"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</picture>
			</div>
		)}

		<!-- 4. In-article ad -->
		<AdInArticle slotId={adSlotInArticle} />

		<!-- 5. Remaining images — full size, same treatment as hero -->
		{galleryImages.map((img, i) => {
			const info = galleryInfos[i];
			const photoNum = (heroImage ? 2 : 1) + i;
			return (
				<div class="post-image-wrap mt-6 -mx-4 sm:mx-0" data-testid="gallery-image">
					<picture>
						{info?.webp && <source type="image/webp" srcset={info.webp} />}
						<img
							src={img}
							alt={`${title} — photo ${photoNum}`}
							width={info?.width}
							height={info?.height}
							class="post-image w-full rounded-none sm:rounded-xl"
							loading="lazy"
							decoding="async"
						/>
					</picture>
				</div>
			);
		})}

		<!-- 6. Bottom ad -->
		<AdSlot slotId={adSlotBottom} />

		<!-- Tags -->
		{tags.length > 0 && (
			<div class="mt-10 pt-6 border-t border-cream-dark">
				<div class="flex flex-wrap gap-2 items-center">
					<span class="text-sm text-stone mr-1">Tags:</span>
					{tags.map(tag => (
						<span class="text-xs text-stone bg-cream-dark px-2.5 py-1 rounded-full">
							{tag}
						</span>
					))}
				</div>
			</div>
		)}

		<!-- Source attribution -->
		{originalUrl && (
			<div class="mt-6 text-xs text-stone">
				Originally published on {source}
			</div>
		)}
	</article>

	<!-- Related posts — same centering container as <article> above -->
	<div class="max-w-3xl mx-auto px-4 sm:px-6">
		<slot name="related" />
	</div>

	<!-- Hide broken images in post bodies -->
	<script>
		document.querySelectorAll('.prose img').forEach(img => {
			(img as HTMLImageElement).addEventListener('error', () => {
				img.classList.add('img-broken');
			});
		});
	</script>
</BaseLayout>

<style>
	/* Images display at full natural dimensions — food photos deserve to be seen in full.
	 * Cropping (the old overflow:hidden + max-height approach) was ambiguous for portrait
	 * IG photos and is removed. Spacing/rounding handled by Tailwind classes on the elements. */
	.post-image {
		display: block; /* prevent inline image gap */
	}
</style>
