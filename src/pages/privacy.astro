---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = '2026-06-03';
---

<BaseLayout
	title="Privacy Policy"
	description="The Thirsty Pig privacy policy — what (little) data this site handles."
>
	<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
		<h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-2">Privacy Policy</h1>
		<p class="text-stone mb-8 text-sm">Last updated: {lastUpdated}</p>

		<div class="prose max-w-none">
			<h2>What We Collect</h2>

			<h3>With Your Consent (Analytics)</h3>
			<p>
				We use <strong>Google Analytics 4</strong> to understand how visitors use
				the site &mdash; page views, session duration, device type, and general
				location (city-level). GA4 only loads if you accept Analytics in our
				consent banner.
			</p>
			<ul>
				<li>Data retained: 14 months</li>
				<li><a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google's privacy policy</a></li>
				<li><a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Opt out of GA4</a></li>
			</ul>

			<h3>With Your Consent (Advertising)</h3>
			<p>
				We use <strong>Google AdSense</strong> to show relevant ads that help fund
				the blog. AdSense only loads if you accept Marketing in our consent banner.
			</p>
			<ul>
				<li><a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener">Google's ad privacy policy</a></li>
				<li><a href="https://myaccount.google.com/data-and-privacy" target="_blank" rel="noopener">Manage your Google ad settings</a></li>
			</ul>

			<h3>Without Consent (Cookieless)</h3>
			<p>
				<strong>Vercel Analytics</strong> tracks only hashed URLs and country
				codes &mdash; no cookies, no personal data, no consent required.
			</p>
			<ul>
				<li><a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener">Vercel's privacy policy</a></li>
			</ul>

			<h2>Your Choices</h2>
			<p>You can change your consent preferences at any time:</p>
			<ol>
				<li>Click <strong>Manage preferences</strong> in the consent banner</li>
				<li>Toggle Analytics and/or Marketing on or off</li>
				<li>Click <strong>Save my choices</strong></li>
			</ol>

			<h2>Your Rights</h2>
			<p>
				<strong>EU/UK residents (GDPR/PECR):</strong> You have the right to access,
				correct, delete, or export your data, and to withdraw consent at any time.
			</p>
			<p>
				<strong>California residents (CCPA/CPRA):</strong> You have the right to
				know what data is collected, request deletion, and opt out of data sharing.
			</p>
			<p>To exercise these rights, email: <a href="mailto:thirstypig@gmail.com">thirstypig@gmail.com</a></p>

			<h2>Cookies</h2>
			<table>
				<thead>
					<tr>
						<th>Cookie</th>
						<th>Purpose</th>
						<th>Consent Required?</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>cookieconsent_status</td>
						<td>Remembers your consent choice</td>
						<td>No (necessary)</td>
					</tr>
					<tr>
						<td>GA4 cookies</td>
						<td>Analytics tracking</td>
						<td>Yes (Analytics)</td>
					</tr>
					<tr>
						<td>AdSense cookies</td>
						<td>Ad targeting</td>
						<td>Yes (Marketing)</td>
					</tr>
				</tbody>
			</table>
			<p>
				You can disable cookies in your browser settings. This may affect site
				functionality.
			</p>

			<h2>Contact</h2>
			<p>
				Questions about this policy?<br />
				Email: <a href="mailto:thirstypig@gmail.com">thirstypig@gmail.com</a><br />
				Site: thirstypig.com<br />
				Last updated: 2026-06-03
			</p>
		</div>
	</section>
</BaseLayout>
