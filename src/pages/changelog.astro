---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { renderMarkdown } from '../utils/markdown-lite';

/**
 * The public changelog renders FROM docs/under-the-hood/changelog.md (DOC-016),
 * which is the canonical source (C-012 / TD-013). This page holds no changelog
 * content of its own — editing the markdown is the only way to change it.
 *
 * Everything above the PUBLIC:START marker in that file is internal (the doc's
 * own frontmatter, H1, and maintenance notes) and is deliberately not shipped.
 *
 * Safety: renderMarkdown() escapes its input BEFORE applying any markdown
 * transform, so raw HTML in the source renders as visible text and cannot
 * execute. That is what makes `set:html` acceptable here — same reasoning as
 * the admin docs board. See src/utils/markdown-lite.test.ts for the
 * adversarial cases.
 */
const MARKER = '<!-- PUBLIC:START -->';
const SOURCE = 'docs/under-the-hood/changelog.md';

const raw = readFileSync(join(process.cwd(), SOURCE), 'utf-8');

const markerAt = raw.indexOf(MARKER);
if (markerAt === -1) {
	throw new Error(
		`[changelog] ${SOURCE} is missing its ${MARKER} marker. ` +
			`Refusing to build rather than publish the internal preamble.`
	);
}

const body = raw.slice(markerAt + MARKER.length);
const html = renderMarkdown(body);

// Count assertion. A silently-empty changelog would look like a styling bug and
// could ship unnoticed; this project has been bitten by succeed-as-no-op before.
const sectionCount = (body.match(/^## /gm) || []).length;
if (sectionCount < 5) {
	throw new Error(
		`[changelog] Only ${sectionCount} sections found in ${SOURCE} (expected >= 5). ` +
			`The source looks truncated — refusing to build.`
	);
}
---

<BaseLayout title="Changelog" description="History of updates to The Thirsty Pig blog.">
	<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
		<h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-2">Changelog</h1>
		<p class="text-stone mb-10">A history of updates to this site.</p>

		<div class="prose max-w-none" set:html={html} />

		<p class="mt-10">
			<a href="/about" class="text-sm text-amber hover:text-rust no-underline">&larr; Back to About</a>
		</p>
	</section>
</BaseLayout>
